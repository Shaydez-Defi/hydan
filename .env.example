# Hardhat 3 uses encrypted keystore for secrets (not .env)
# Set variables with: npx hardhat vars set <NAME>

# Sepolia RPC URL (get from Alchemy, Infura, QuickNode, etc.)
# npx hardhat vars set SEPOLIA_RPC_URL

# Deployer private key (without 0x prefix)
# npx hardhat vars set SEPOLIA_PRIVATE_KEY

# Optional: Etherscan API key for contract verification
# npx hardhat vars set ETHERSCAN_API_KEY

# Optional: Tenderly for verification
# npx hardhat vars set TENDERLY_ACCESS_KEY
# npx hardhat vars set TENDERLY_PROJECT
# npx hardhat vars set TENDERLY_USERNAME